# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
# 증권사 두 곳 중 키를 채운 쪽이 자동으로 선택된다 (둘 다 있으면 키움 우선).
# STOCK_WAR_PROVIDER 로 명시할 수도 있다: kiwoom | kis

# --- 키움증권 REST API (openapi.kiwoom.com) ---
# 실전 키와 모의 키는 서로 호환되지 않아 두 쌍을 따로 둔다. KIWOOM_ENV 만 바꾸면
# 알맞은 쌍이 선택된다 — 키를 손으로 옮기다 배포에 실전 키가 섞이는 일이 없게.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_DEMO_APP_KEY=
KIWOOM_DEMO_SECRET_KEY=
# demo = 모의투자(기본, mockapi.kiwoom.com) / real = 실전(api.kiwoom.com)
KIWOOM_ENV=demo

# --- 한국투자증권 (apiportal.koreainvestment.com) ---
KIS_APP_KEY=
KIS_APP_SECRET=
# vts = 모의투자(기본) / prod = 실전
KIS_ENV=vts

# --- 공개 배포 ---
# 1 로 두면 실전 키(KIWOOM_ENV=real / KIS_ENV=prod)로는 서버가 뜨지 않고,
# 개발자 툴도 닫히며, 바깥 네트워크로 연다. 로컬에서는 비워 둔다.
STOCK_WAR_PUBLIC=

# --- 공통 ---
STOCK_WAR_SYMBOL=005930
STOCK_WAR_NAME=삼성전자
